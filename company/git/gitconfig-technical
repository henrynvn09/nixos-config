# company/git/gitconfig-technical — Technical Git settings only
# Source: modules/core/git.nix
#
# ⚠️  NO personal identity (user.name / user.email)
#     Use whatever your company configures, or set it manually:
#     git config --global user.name "Your Name"
#     git config --global user.email "you@company.com"

[core]
    autocrlf = input
    symlinks = true

[init]
    defaultBranch = main

[push]
    default = current

[pull]
    rebase = true

